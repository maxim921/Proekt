<Window x:Class="proekt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление автопарком" Height="520" Width="950">
    <TabControl>

        <TabItem Header="Автомобили">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="CarsGrid" AutoGenerateColumns="False"
                          SelectionChanged="CarsGrid_SelectionChanged" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Гос. номер" Binding="{Binding LicensePlate}" Width="100"/>
                        <DataGridTextColumn Header="Модель" Binding="{Binding Model}" Width="130"/>
                        <DataGridTextColumn Header="Производитель" Binding="{Binding Manufacturer}" Width="120"/>
                        <DataGridTextColumn Header="Год" Binding="{Binding YearOfManufacture}" Width="60"/>
                        <DataGridTextColumn Header="Пробег, км" Binding="{Binding Mileage}" Width="90"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90"/>
                        <DataGridCheckBoxColumn Header="Нужно ТО" Binding="{Binding NeedService, Mode=OneWay}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="Гос. номер"/>
                    <TextBox x:Name="tbPlate"/>
                    <TextBlock Text="Модель"/>
                    <TextBox x:Name="tbModel"/>
                    <TextBlock Text="Производитель"/>
                    <TextBox x:Name="tbManuf"/>
                    <TextBlock Text="Год выпуска"/>
                    <TextBox x:Name="tbYear"/>
                    <TextBlock Text="Пробег, км"/>
                    <TextBox x:Name="tbMileage"/>
                    <TextBlock Text="Статус"/>
                    <ComboBox x:Name="cbStatus" SelectedIndex="0">
                        <ComboBoxItem>Доступен</ComboBoxItem>
                        <ComboBoxItem>В ремонте</ComboBoxItem>
                    </ComboBox>
                    <Button Content="Добавить" Margin="0,10,0,5" Click="BtnAddCar_Click"/>
                    <Button Content="Сохранить изменения" Margin="0,0,0,5" Click="BtnEditCar_Click"/>
                    <Button Content="Удалить" Margin="0,0,0,5" Click="BtnDeleteCar_Click"/>
                    <Button Content="Сортировать по пробегу" Margin="0,0,0,5" Click="BtnSortCars_Click"/>
                    <Button Content="Отчёт: суммарный пробег" Click="BtnReport_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Водители">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="270"/>
                </Grid.ColumnDefinitions>
                <DataGrid x:Name="DriversGrid" AutoGenerateColumns="False"
                          SelectionChanged="DriversGrid_SelectionChanged" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="180"/>
                        <DataGridTextColumn Header="Права" Binding="{Binding LicenseNumber}" Width="100"/>
                        <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="120"/>
                        <DataGridTextColumn Header="Стаж, лет" Binding="{Binding Experience}" Width="80"/>
                        <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel Grid.Column="1" Margin="15,0,0,0">
                    <TextBlock Text="ФИО"/>
                    <TextBox x:Name="tbFio"/>
                    <TextBlock Text="Номер прав"/>
                    <TextBox x:Name="tbLicense"/>
                    <TextBlock Text="Телефон"/>
                    <TextBox x:Name="tbPhone"/>
                    <TextBlock Text="Стаж, лет"/>
                    <TextBox x:Name="tbExp"/>
                    <TextBlock Text="Email"/>
                    <TextBox x:Name="tbEmail"/>
                    <TextBlock Text="Пароль"/>
                    <PasswordBox x:Name="pbPass"/>
                    <Button Content="Добавить" Margin="0,10,0,5" Click="BtnAddDriver_Click"/>
                    <Button Content="Сохранить изменения" Margin="0,0,0,5" Click="BtnEditDriver_Click"/>
                    <Button Content="Удалить" Click="BtnDeleteDriver_Click"/>
                </StackPanel>
            </Grid>
        </TabItem>
        <TabItem Header="Рейсы">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <GroupBox Header="Новый рейс" Grid.Row="0" Padding="5">
                    <WrapPanel>
                        <TextBlock Text="Машина: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbVeh" Width="150" Margin="0,0,10,0"/>
                        <TextBlock Text="Водитель: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbDrv" Width="150" Margin="0,0,10,0"/>
                        <TextBlock Text="Откуда: " VerticalAlignment="Center"/>
                        <TextBox x:Name="tbStartLoc" Width="90" Margin="0,0,10,0"/>
                        <TextBlock Text="Куда: " VerticalAlignment="Center"/>
                        <TextBox x:Name="tbEndLoc" Width="90" Margin="0,0,10,0"/>
                        <TextBlock Text="Расстояние, км: " VerticalAlignment="Center"/>
                        <TextBox x:Name="tbDist" Width="70" Margin="0,0,10,0"/>
                        <TextBlock Text="Начало: " VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpStart" Margin="0,0,10,0"/>
                        <Button Content="Зарегистрировать" Click="BtnRegisterTrip_Click"/>
                    </WrapPanel>
                </GroupBox>

                <DataGrid x:Name="TripsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,8">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Машина" Binding="{Binding Vehicle.Model}" Width="120"/>
                        <DataGridTextColumn Header="Гос. номер" Binding="{Binding Vehicle.LicensePlate}" Width="100"/>
                        <DataGridTextColumn Header="Водитель" Binding="{Binding Driver.FullName}" Width="150"/>
                        <DataGridTextColumn Header="Начало" Binding="{Binding StartDate, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="Конец" Binding="{Binding EndDate, StringFormat=d}" Width="90"/>
                        <DataGridTextColumn Header="Откуда" Binding="{Binding StartLocation}" Width="100"/>
                        <DataGridTextColumn Header="Куда" Binding="{Binding EndLocation}" Width="100"/>
                        <DataGridTextColumn Header="Км" Binding="{Binding Distance}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>

                <GroupBox Header="Фильтры" Grid.Row="2" Padding="5">
                    <WrapPanel>
                        <TextBlock Text="С: " VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpFrom" Margin="0,0,10,0"/>
                        <TextBlock Text="По: " VerticalAlignment="Center"/>
                        <DatePicker x:Name="dpTo" Margin="0,0,10,0"/>
                        <TextBlock Text="Машина: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbFVeh" Width="130" Margin="0,0,10,0"/>
                        <TextBlock Text="Водитель: " VerticalAlignment="Center"/>
                        <ComboBox x:Name="cbFDrv" Width="130" Margin="0,0,10,0"/>
                        <Button Content="Применить" Margin="0,0,10,0" Click="BtnFilter_Click"/>
                        <Button Content="Сбросить" Margin="0,0,10,0" Click="BtnResetFilter_Click"/>
                        <Button Content="Завершить выбранный рейс" Click="BtnEndTrip_Click"/>
                        <Button Content="История машины" Margin="10,0,0,0" Click="BtnHistory_Click"/>
                        <Button Content="История водителя" Margin="10,0,0,0" Click="BtnHistoryDrv_Click"/>
                    </WrapPanel>
                </GroupBox>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
